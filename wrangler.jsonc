{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extension",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
